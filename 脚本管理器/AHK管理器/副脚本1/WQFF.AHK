#Requires AutoHotkey v2.0
#SingleInstance Force
#UseHook


; ============================================================
; W + Q 按住，并持续重复按 F
; ============================================================
;
; F6 = 开启
; F7 = 暂停
;
; 保持按键:
; W Q
;
; 循环按键:
; F
;
; 速度:
; 100
;
; ============================================================



; ============================================================
; GUI模板
; 后期修改窗口只改这里
; ============================================================

guiTitle := "W Q F 控制"

guiWidth := 300
guiHeight := 35



; ============================================================
; 状态变量
; ============================================================

running := false


; Timer绑定
PressFTimer := PressF.Bind()



; ============================================================
; 循环设置
; 后期修改速度只改这里
; ============================================================

fInterval := 100



; ============================================================
; 创建窗口
; ============================================================

myGui := Gui(
    "+AlwaysOnTop",
    guiTitle
)



myGui.SetFont(
    "s9 cFFFFFF",
    "Microsoft YaHei"
)



statusText := myGui.AddText(
    "x10 y7 w" (guiWidth-20) " h20 Center",
    "● 待机 | F6 开启"
)



myGui.BackColor := "000000"



; ============================================================
; 默认左上角显示
; 可以直接拖动
; ============================================================

myGui.Show(
    "x0 y0 w" guiWidth " h" guiHeight
)



; ============================================================
; 写入自己的 GUI 句柄
; ============================================================

glFile := A_ScriptDir "\" A_ScriptName ".txt"



if FileExist(glFile)
{
    FileDelete(glFile)
}



FileAppend(
    myGui.Hwnd,
    glFile
)



WinSetTransparent(
    220,
    myGui
)



; ============================================================
; F6 开启
; ============================================================

*F6::
{
    global running
    global fInterval


    ; 已经运行不重复开启
    if running
        return



    running := true



    ; ----------------------------
    ; 保持 W
    ; ----------------------------

    SendEvent "{w down}"



    ; ----------------------------
    ; 保持 Q
    ; ----------------------------

    SendEvent "{q down}"



    ; ----------------------------
    ; 开始 F循环
    ; ----------------------------

    SetTimer(
        PressFTimer,
        fInterval
    )



    UpdateStatus(
        "运行-WQ按住中F循环中/释放-按F7暂停"
    )
}



; ============================================================
; F7 暂停
; ============================================================

*F7::
{
    global running



    if !running
        return



    running := false



    ; 停止F循环

    SetTimer(
        PressFTimer,
        0
    )



    ; 释放W

    SendEvent "{w up}"



    ; 释放Q

    SendEvent "{q up}"



    UpdateStatus(
        "● 待机 | F6 开启"
    )
}



; ============================================================
; F循环
; ============================================================

PressF()
{
    global running



    if !running
        return



    SendEvent "{f down}"

    SendEvent "{f up}"
}



; ============================================================
; 更新状态
; ============================================================

UpdateStatus(text)
{
    global statusText


    statusText.Text := text
}



; ============================================================
; 退出保险
; ============================================================

OnExit(
    ReleaseKeys
)



ReleaseKeys(*)
{
    global running
    global PressFTimer



    SetTimer(
        PressFTimer,
        0
    )



    SendEvent "{w up}"

    SendEvent "{q up}"

    SendEvent "{f up}"



    running := false
}



; ============================================================
; GL管理器退出通信
; ============================================================

OnMessage(
    0xB001,
    GL_Exit
)



GL_Exit(*)
{
    ExitApp
}